{# Components: addComponents — controls, popup, search, basemap switcher (legend now server-rendered) #}
      function addComponents(config, mapOrMaps) {
        const maps = Array.isArray(mapOrMaps) ? mapOrMaps : [mapOrMaps];
        const map = maps[0];
        const components = config.components || [];

        // Get locale from config, default to en-US
        const locale = config.locale || "en-US";
        const normalizedLocale = String(locale).replace(/_/g, "-");

        function formatValue(val, fieldName) {
          if (val == null) return "";

          // Special case: year field - never format with thousand separators
          if (fieldName === 'year' && typeof val === 'number') {
            return String(Math.round(val));
          }

          // If value is a number, format with locale-aware separators
          if (typeof val === 'number') {
            return val.toLocaleString(locale, {
              maximumFractionDigits: 2
            });
          }

          // If value is a string that looks like a number, parse and format it
          if (typeof val === 'string') {
            const trimmed = val.trim();
            const parsed = Number(trimmed);

            // Ensure parsing succeeded and the string is not empty
            if (!isNaN(parsed) && trimmed !== '' && /^-?\d+\.?\d*$/.test(trimmed)) {
              // Check if it's a year field or year-like value (4-digit integer 1900-2100)
              if (fieldName === 'year' || (Number.isInteger(parsed) && parsed >= 1900 && parsed <= 2100 && trimmed.length === 4)) {
                return String(Math.round(parsed));
              }
              return parsed.toLocaleString(locale, {
                maximumFractionDigits: 2
              });
            }
          }

          // Otherwise return as string
          return String(val);
        }
        components.forEach(c => {
          if (c.type === "controls") {
            if (c.zoom)
              map.addControl(new maplibregl.NavigationControl(), "top-left");
            if (c.scale && typeof maplibregl.ScaleControl === "function")
              map.addControl(new maplibregl.ScaleControl(), "bottom-left");
            if (c.fullscreen && maplibregl.FullscreenControl)
              map.addControl(new maplibregl.FullscreenControl(), "top-left");
          }
        });

        const basemapSwitcherConfig = components.find(c => c.type === "basemap_switcher");
        const hasTileProviders = config.tile_providers && config.tile_providers.length > 0;

        function tileUrl(tiles) {
          const t = (tiles && tiles.url_template) || "";
          return t.replace("{s}", (tiles.subdomains && tiles.subdomains[0]) || "a");
        }
        
        // Make switchBasemap available globally for server-rendered legend
        window.llmaps_switchBasemap = function(providerId) {
          const provider = config.tile_providers.find(function(p) { return p.id === providerId; });
          if (!provider) return;
          const url = tileUrl(provider);
          maps.forEach(function(m) {
            if (!m.getLayer || !m.getSource) return;
            if (m.getLayer("llmaps-base")) m.removeLayer("llmaps-base");
            if (m.getSource("llmaps-base")) m.removeSource("llmaps-base");
            m.addSource("llmaps-base", {
              type: "raster",
              tiles: [url],
              tileSize: 256,
              attribution: provider.attribution || ""
            });
            const layers = m.getStyle().layers;
            const firstId = layers && layers[0] ? layers[0].id : undefined;
            m.addLayer({ id: "llmaps-base", type: "raster", source: "llmaps-base" }, firstId);
          });
        };
        
        function createBasemapSelect(config, maps, currentId) {
          const wrap = document.createElement("div");
          wrap.className = "llmaps-basemap-select-wrap";
          const select = document.createElement("select");
          select.className = "llmaps-basemap-select";
          config.tile_providers.forEach(function(provider) {
            const opt = document.createElement("option");
            opt.value = provider.id;
            opt.textContent = provider.name || provider.id;
            if (provider.id === currentId) opt.selected = true;
            select.appendChild(opt);
          });
          select.addEventListener("change", function() {
            window.llmaps_switchBasemap(select.value);
          });
          wrap.appendChild(select);
          return wrap;
        }

        // Legend is now server-rendered, skip client-side generation

        // Standalone basemap switcher (if not embedded in legend)
        const legendConfig = components.find(c => c.type === "legend");
        const basemapInLegend = legendConfig && hasTileProviders;

        if (basemapSwitcherConfig && hasTileProviders && !basemapInLegend) {
          const currentTiles = config.tiles || {};
          const currentId = currentTiles.id || (config.tile_providers[0] && config.tile_providers[0].id);
          const wrap = document.createElement("div");
          wrap.className = "llmaps-basemap-switcher " + (basemapSwitcherConfig.position || "top-left");
          wrap.style.position = "absolute";
          wrap.style.zIndex = "10";
          wrap.appendChild(createBasemapSelect(config, maps, currentId));
          document.body.appendChild(wrap);
        }

        const popupConfig = components.find(c => c.type === "popup");
        if (popupConfig && typeof maplibregl.Popup === "function") {
          const defaultFields = popupConfig.fields || [];
          const fieldLabels = popupConfig.field_labels || {};
          const fieldsByLayer = popupConfig.fields_by_layer || {};
          const popupTrigger = popupConfig.trigger || "click";
          const layers = config.layers || [];

          // Layers with sidebar: skip click popup (click opens sidebar), but allow hover popup
          const _sidebarCfg = components.find(c => c.type === "sidebar");
          const sidebarLayerIds = _sidebarCfg && _sidebarCfg.fields_by_layer
            ? new Set(Object.keys(_sidebarCfg.fields_by_layer)) : new Set();

          function popupContent(feature, layerId) {
            const fields = fieldsByLayer[layerId] && fieldsByLayer[layerId].length
              ? fieldsByLayer[layerId] : defaultFields;
            const props = feature.properties || {};
            if (!fields.length) return Object.keys(props).length ? JSON.stringify(props) : "";
            const rows = fields.map(f => {
              const label = fieldLabels[f] || f;
              const val = props[f];
              return "<tr><td>" + label + "</td><td>" + formatValue(val, f) + "</td></tr>";
            });
            return "<table style=\"font-size:12px;\">" + rows.join("") + "</table>";
          }

          function lngLat(feature) {
            const g = feature.geometry;
            if (!g || !g.coordinates) return null;
            const c = g.coordinates;
            if (g.type === "Point") return c;
            if (g.type === "LineString" || g.type === "MultiPoint") return c[0];
            if (g.type === "Polygon") return c[0][0];
            if (g.type === "MultiLineString") return c[0][0];
            if (g.type === "MultiPolygon") return c[0][0][0];
            if (c[0] != null && typeof c[0] === "number") return c;
            if (Array.isArray(c[0]) && c[0].length >= 2 && typeof c[0][0] === "number") return c[0];
            return null;
          }

          function addPopupToMap(m) {
            if (!m || !m.getLayer) return;

            const hasFieldsByLayer = Object.keys(fieldsByLayer).length > 0;
            if (popupTrigger === "hover") {
              var hoverPopup = new maplibregl.Popup({ closeButton: false, closeOnClick: false });
              layers.forEach(layerCfg => {
                const layerId = layerCfg.id;
                if (!m.getLayer(layerId)) return;
                if (hasFieldsByLayer && !fieldsByLayer[layerId]) return;
                m.on("mousemove", layerId, function(ev) {
                  const feat = ev.features && ev.features[0];
                  if (!feat) return;
                  var html = popupContent(feat, layerId);
                  if (!html) return;
                  m.getCanvas().style.cursor = "pointer";
                  hoverPopup.setLngLat(ev.lngLat).setHTML(html).addTo(m);
                });
                m.on("mouseleave", layerId, function() {
                  m.getCanvas().style.cursor = "";
                  hoverPopup.remove();
                });
              });
            } else {
              // Single map click + queryRenderedFeatures + layer type priority (points over polygons)
              // When fields_by_layer is set, only layers listed there get popup (e.g. no popup on point layer)
              const popupLayerIds = layers
                .filter(function(l) {
                  if (sidebarLayerIds.has(l.id) || !m.getLayer(l.id)) return false;
                  if (hasFieldsByLayer && !fieldsByLayer[l.id]) return false;
                  return true;
                })
                .map(function(l) { return l.id; });
              const typePriority = { circle: 0, symbol: 1, line: 2, fill: 3 };
              var currentPopup = null;
              var selectedFeature = null;
              var _prevHl = null; // { map, source, id }
              function _hlClear() {
                if (_prevHl) {
                  _prevHl.map.removeFeatureState({ source: _prevHl.source, id: _prevHl.id }, 'selected');
                  _prevHl = null;
                }
              }
              function _hlEnsureLayer(m, sourceId, parentLayerType, sourceLayer) {
                var hlId = 'llmaps-hl-' + sourceId;
                if (m.getLayer(hlId)) return;
                var isPoint = parentLayerType === 'circle' || parentLayerType === 'symbol';
                var sel = ['boolean', ['feature-state', 'selected'], false];
                var spec = isPoint
                  ? { id: hlId, type: 'circle', source: sourceId,
                      paint: { 'circle-radius': ['case', sel, 10, 0],
                               'circle-color': 'transparent',
                               'circle-stroke-color': '#111111',
                               'circle-stroke-width': ['case', sel, 2.5, 0] } }
                  : { id: hlId, type: 'line', source: sourceId,
                      paint: { 'line-color': '#111111',
                               'line-width': ['case', sel, 3.5, 0] } };
                if (sourceLayer) spec['source-layer'] = sourceLayer;
                m.addLayer(spec);
              }
              function _hlSet(m, feat) {
                _hlClear();
                if (!feat || feat.id == null) return;
                var sourceId = feat.source;
                _hlEnsureLayer(m, sourceId, feat.layer && feat.layer.type, feat.sourceLayer);
                m.setFeatureState({ source: sourceId, id: feat.id }, { selected: true });
                _prevHl = { map: m, source: sourceId, id: feat.id };
              }
              m.on("click", function(ev) {
                if (currentPopup) {
                  currentPopup.remove();
                  currentPopup = null;
                }
                _hlSet(m, null);
                selectedFeature = null;
                if (!popupLayerIds.length) return;
                var features = m.queryRenderedFeatures(ev.point, { layers: popupLayerIds });
                if (!features.length) return;
                features.sort(function(a, b) {
                  var typeA = (m.getLayer(a.layer.id) && m.getLayer(a.layer.id).type) || "fill";
                  var typeB = (m.getLayer(b.layer.id) && m.getLayer(b.layer.id).type) || "fill";
                  return (typePriority[typeA] !== undefined ? typePriority[typeA] : 99) - (typePriority[typeB] !== undefined ? typePriority[typeB] : 99);
                });
                var feat = features[0];
                var layerId = feat.layer.id;
                _hlSet(m, feat);
                selectedFeature = feat;
                currentPopup = new maplibregl.Popup()
                  .setLngLat(ev.lngLat)
                  .setHTML(popupContent(feat, layerId))
                  .addTo(m);
                // Clear highlight when popup is closed manually
                currentPopup.on('close', function() {
                  _hlClear();
                  currentPopup = null;
                  selectedFeature = null;
                });
              });
              m.getCanvas().style.cursor = "pointer";
            }
          }

          window.llmapsOnLayersReady(function(m) {
            addPopupToMap(m);
          });
          
          // Export for external map instances (e.g., comparison maps created via custom JS)
          window.llmapsAddPopupToMap = addPopupToMap;
        }

        // Sidebar
        const sidebarConfig = components.find(c => c.type === "sidebar");
        if (sidebarConfig) {
          const sbWidth = sidebarConfig.width || 400;
          const sbPosition = sidebarConfig.position || "right";
          const sbFieldsByLayer = sidebarConfig.fields_by_layer || {};
          const sbFieldLabels = sidebarConfig.field_labels || {};
          const sbTitleField = sidebarConfig.title_field || null;
          const sbTitleByLayer = sidebarConfig.title_by_layer || {};
          const sbCloseOnMapClick = sidebarConfig.close_on_map_click !== false;
          const sbZoomOnClick = sidebarConfig.zoom_on_click;
          const sbHideEmptyFields = sidebarConfig.hide_empty_fields !== false;
          const layers = config.layers || [];

          // Create sidebar DOM
          const sbEl = document.createElement("div");
          sbEl.id = "llmaps-sidebar";
          sbEl.className = "llmaps-sidebar " + sbPosition;
          sbEl.style.setProperty("--llmaps-sidebar-width", sbWidth + "px");
          document.body.appendChild(sbEl);

          var sbIgnoreNextMapClick = false;

          function sidebarOpen(layerId, feature) {
            const props = feature.properties || {};
            const fields = sbFieldsByLayer[layerId] || Object.keys(props);
            const title = (sbTitleField && props[sbTitleField])
              ? String(props[sbTitleField])
              : (sbTitleByLayer[layerId] || "Feature info");

            let html = '<div class="llmaps-sidebar-header">'
              + '<h2 class="llmaps-sidebar-title">' + _sbEsc(title) + '</h2>'
              + '<button class="llmaps-sidebar-close" title="Close">&times;</button>'
              + '</div>'
              + '<div class="llmaps-sidebar-content"><div class="llmaps-sidebar-section">';

            fields.forEach(function(f) {
              const label = sbFieldLabels[f] || f;
              const val = props[f];
              // Skip empty/null/whitespace-only values if enabled
              if (sbHideEmptyFields) {
                if (val == null) return;
                if (typeof val === "string" && val.trim() === "") return;
              }
              var linkHtml = _sbLinkField(f, val);
              var valueHtml = linkHtml !== false ? linkHtml : _sbEsc(formatValue(val, f));
              html += '<div class="llmaps-sidebar-field">'
                + '<span class="llmaps-sidebar-field-label">' + _sbEsc(label) + '</span>'
                + '<span class="llmaps-sidebar-field-value">' + valueHtml + '</span>'
                + '</div>';
            });

            html += '</div></div>';
            sbEl.innerHTML = html;
            sbEl.classList.add("open");

            sbEl.querySelector(".llmaps-sidebar-close").addEventListener("click", sidebarClose);
          }

          function sidebarClose() {
            sbEl.classList.remove("open");
          }

          function _sbEsc(str) {
            var d = document.createElement("div");
            d.textContent = str;
            return d.innerHTML;
          }

          function _sbLinkField(fieldName, val) {
            if (val == null || typeof val !== "string") return false;
            var v = val.trim();
            if (v.indexOf("http://") !== 0 && v.indexOf("https://") !== 0) return false;
            if (fieldName !== "url" && fieldName !== "detail") return false;
            var d = document.createElement("div");
            d.textContent = v;
            var escaped = d.innerHTML;
            var href = v.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/'/g, "&#39;").replace(/</g, "&lt;");
            return '<a href="' + href + '" target="_blank" rel="noopener noreferrer">' + escaped + '</a>';
          }

          // Expose API globally
          window.llmapsSidebarOpen = sidebarOpen;
          window.llmapsSidebarClose = sidebarClose;

          // Register click handlers
          window.llmapsOnLayersReady(function(m) {
            var layerIds = Object.keys(sbFieldsByLayer);
            if (!layerIds.length) {
              layerIds = layers.map(function(l) { return l.id; });
            }
            layerIds.forEach(function(layerId) {
              if (!m.getLayer(layerId)) return;
              m.on("click", layerId, function(ev) {
                var feat = ev.features && ev.features[0];
                if (!feat) {
                  if (ev.features && ev.features.length === 0 && console && typeof console.warn === "function")
                    console.warn("LLMaps sidebar: click on layer " + layerId + " returned no features");
                  return;
                }
                if (ev.originalEvent) ev.originalEvent.stopPropagation();
                if (typeof ev.preventDefault === "function") ev.preventDefault();
                sbIgnoreNextMapClick = true;
                sidebarOpen(layerId, feat);
                if (sbZoomOnClick != null) {
                  var g = feat.geometry;
                  if (g && g.type === "Point" && g.coordinates) {
                    m.flyTo({ center: g.coordinates, zoom: sbZoomOnClick, duration: 1500 });
                  }
                }
              });
            });

            if (sbCloseOnMapClick) {
              m.on("click", function(ev) {
                if (sbIgnoreNextMapClick) {
                  sbIgnoreNextMapClick = false;
                  return;
                }
                if (!ev.defaultPrevented) sidebarClose();
              });
            }
          });
        }

        // Dashboard
        const dashboardConfig = components.find(c => c.type === "dashboard");
        if (dashboardConfig) {
          const dashboardId = dashboardConfig.dashboard_id || "dashboard";
          const dashboardPosition = dashboardConfig.position || "top-right";
          const dashboardTitle = dashboardConfig.title || "Dashboard";
          const dashboardWidth = dashboardConfig.width || 360;
          const dashboardHeight = dashboardConfig.height;
          const dashboardCollapsible = dashboardConfig.collapsible !== false;
          const dashboardFilters = Array.isArray(dashboardConfig.filters) ? dashboardConfig.filters : [];
          const dashboardEmptyState = dashboardConfig.empty_state || "No dashboard content yet.";
          const dashboardEl = document.createElement("section");
          const dashboardHeader = document.createElement("div");
          const dashboardTitleEl = document.createElement("h2");
          const dashboardBody = document.createElement("div");
          const dashboardFilterBar = document.createElement("div");
          const dashboardContent = document.createElement("div");
          let dashboardToggleBtn = null;
          const dashboardState = {};

          dashboardEl.className = "llmaps-dashboard " + dashboardPosition;
          dashboardEl.setAttribute("data-dashboard-id", dashboardId);
          dashboardEl.style.setProperty("--llmaps-dashboard-width", dashboardWidth + "px");
          if (dashboardHeight != null) {
            dashboardEl.style.setProperty("--llmaps-dashboard-height", dashboardHeight + "px");
          }

          dashboardHeader.className = "llmaps-dashboard-header";
          dashboardTitleEl.className = "llmaps-dashboard-title";
          dashboardTitleEl.textContent = dashboardTitle;
          dashboardHeader.appendChild(dashboardTitleEl);

          if (dashboardCollapsible) {
            dashboardToggleBtn = document.createElement("button");
            dashboardToggleBtn.type = "button";
            dashboardToggleBtn.className = "llmaps-dashboard-toggle";
            dashboardToggleBtn.setAttribute("aria-label", "Toggle dashboard");
            dashboardHeader.appendChild(dashboardToggleBtn);
          }

          dashboardBody.className = "llmaps-dashboard-body";
          dashboardFilterBar.className = "llmaps-dashboard-filters";
          dashboardContent.className = "llmaps-dashboard-content";
          dashboardBody.appendChild(dashboardFilterBar);
          dashboardBody.appendChild(dashboardContent);
          dashboardEl.appendChild(dashboardHeader);
          dashboardEl.appendChild(dashboardBody);

          function dashboardSetContent(html) {
            dashboardContent.innerHTML = "";
            if (html && String(html).trim() !== "") {
              dashboardContent.innerHTML = html;
              dashboardContent.classList.remove("is-empty");
              return;
            }
            dashboardContent.classList.add("is-empty");
            const emptyEl = document.createElement("div");
            emptyEl.className = "llmaps-dashboard-empty";
            emptyEl.textContent = dashboardEmptyState;
            dashboardContent.appendChild(emptyEl);
          }

          function dashboardDispatch(filterId, value) {
            window.dispatchEvent(new CustomEvent("llmaps:dashboard-filter-change", {
              detail: {
                dashboardId: dashboardId,
                filterId: filterId,
                value: value,
                state: Object.assign({}, dashboardState),
              }
            }));
          }

          function dashboardNormalizeOptions(options) {
            if (!Array.isArray(options)) return [];
            return options.map(function(option) {
              if (option && typeof option === "object" && option.value !== undefined) {
                return {
                  value: String(option.value),
                  label: String(option.label != null ? option.label : option.value),
                };
              }
              return { value: String(option), label: String(option) };
            });
          }

          function dashboardResolveDateLocale() {
            if (!window.flatpickr) return "default";
            if (normalizedLocale.toLowerCase().indexOf("ru") === 0) {
              return (window.flatpickr.l10ns && window.flatpickr.l10ns.ru) || "ru";
            }
            return "default";
          }

          function dashboardCreateFilter(filterConfig, index) {
            const filterId = filterConfig.id || ("filter-" + index);
            const filterType = filterConfig.type || "select";
            const filterWrap = document.createElement("label");
            const filterLabel = document.createElement("span");
            let input;
            let emitEventName = filterType === "text" ? "input" : "change";

            filterWrap.className = "llmaps-dashboard-filter";
            filterWrap.setAttribute("data-filter-id", filterId);
            filterLabel.className = "llmaps-dashboard-filter-label";
            filterLabel.textContent = filterConfig.label || filterId;
            filterWrap.appendChild(filterLabel);

            if (filterType === "select") {
              input = document.createElement("select");
              dashboardNormalizeOptions(filterConfig.options).forEach(function(option) {
                const optionEl = document.createElement("option");
                optionEl.value = option.value;
                optionEl.textContent = option.label;
                input.appendChild(optionEl);
              });
            } else {
              input = document.createElement("input");
              input.type = "text";
              if (filterConfig.placeholder) input.placeholder = filterConfig.placeholder;
            }

            input.className = "llmaps-dashboard-filter-input";
            input.setAttribute("lang", normalizedLocale);
            if (filterConfig.value != null) input.value = String(filterConfig.value);
            dashboardState[filterId] = input.value;

            if (filterType === "date" && window.flatpickr) {
              window.flatpickr(input, {
                dateFormat: "Y-m-d",
                defaultDate: filterConfig.value != null ? String(filterConfig.value) : null,
                allowInput: true,
                disableMobile: true,
                locale: dashboardResolveDateLocale(),
                onChange: function(selectedDates, dateStr) {
                  dashboardState[filterId] = dateStr;
                  dashboardDispatch(filterId, dateStr);
                },
              });
              input.addEventListener("input", function() {
                dashboardState[filterId] = input.value;
              });
            } else {
              input.addEventListener(emitEventName, function() {
                dashboardState[filterId] = input.value;
                dashboardDispatch(filterId, input.value);
              });
            }

            filterWrap.appendChild(input);
            dashboardFilterBar.appendChild(filterWrap);
          }

          function dashboardSetCollapsed(collapsed) {
            dashboardEl.classList.toggle("collapsed", !!collapsed);
            if (dashboardToggleBtn) {
              dashboardToggleBtn.textContent = collapsed ? "+" : "-";
              dashboardToggleBtn.setAttribute("aria-expanded", collapsed ? "false" : "true");
            }
          }

          dashboardFilters.forEach(dashboardCreateFilter);
          if (!dashboardFilters.length) {
            dashboardFilterBar.style.display = "none";
          }

          if (dashboardToggleBtn) {
            dashboardToggleBtn.addEventListener("click", function() {
              dashboardSetCollapsed(!dashboardEl.classList.contains("collapsed"));
            });
          }

          if (!window.llmapsDashboards) window.llmapsDashboards = {};
          window.llmapsDashboards[dashboardId] = {
            element: dashboardEl,
            state: dashboardState,
            setContent: dashboardSetContent,
            setTitle: function(title) { dashboardTitleEl.textContent = title; },
            setCollapsed: dashboardSetCollapsed,
          };
          window.llmapsDashboardSetContent = function(id, html) {
            var dashboard = window.llmapsDashboards && window.llmapsDashboards[id];
            if (dashboard) dashboard.setContent(html);
          };
          window.llmapsDashboardSetTitle = function(id, title) {
            var dashboard = window.llmapsDashboards && window.llmapsDashboards[id];
            if (dashboard) dashboard.setTitle(title);
          };
          window.llmapsDashboardGetState = function(id) {
            var dashboard = window.llmapsDashboards && window.llmapsDashboards[id];
            return dashboard ? Object.assign({}, dashboard.state) : null;
          };
          window.llmapsDashboardSetCollapsed = function(id, collapsed) {
            var dashboard = window.llmapsDashboards && window.llmapsDashboards[id];
            if (dashboard) dashboard.setCollapsed(collapsed);
          };

          map.getContainer().appendChild(dashboardEl);
          dashboardSetContent(dashboardConfig.content_html || "");
          dashboardSetCollapsed(!!dashboardConfig.collapsed);
        }

        // FeatureSearch — search within map data attributes
        const featureSearchConfig = components.find(c => c.type === "feature_search");
        if (featureSearchConfig) {
          const fsPosition = featureSearchConfig.position || "top-center";
          const fsPlaceholder = featureSearchConfig.placeholder || "Search...";
          const fsSearchFields = featureSearchConfig.search_fields || {};
          const fsFieldLabels = featureSearchConfig.field_labels || {};
          const fsMaxResults = featureSearchConfig.max_results || 15;
          const fsZoom = featureSearchConfig.zoom_on_select || 8;
          const fsDebounce = featureSearchConfig.debounce_ms || 200;
          const fsMinChars = featureSearchConfig.min_chars || 2;

          // Build DOM
          const fsWrap = document.createElement("div");
          fsWrap.className = "llmaps-feature-search " + fsPosition;
          const fsInput = document.createElement("input");
          fsInput.type = "text";
          fsInput.placeholder = fsPlaceholder;
          fsInput.autocomplete = "off";
          fsInput.className = "llmaps-feature-search-input";
          fsWrap.appendChild(fsInput);
          const fsDropdown = document.createElement("div");
          fsDropdown.className = "llmaps-feature-search-dropdown";
          fsWrap.appendChild(fsDropdown);
          map.getContainer().appendChild(fsWrap);

          // Cache source data for searching
          var _fsCache = {};

          function fsBuildCache() {
            var sourceIds = Object.keys(fsSearchFields);
            sourceIds.forEach(function(sourceId) {
              if (_fsCache[sourceId]) return;
              if (typeof window.llmapsGetSourceData === "function") {
                window.llmapsGetSourceData(sourceId).then(function(geojson) {
                  if (geojson && geojson.features) {
                    _fsCache[sourceId] = geojson.features;
                  }
                });
              }
            });
          }

          function fsSearch(query) {
            var results = [];
            var qLower = query.toLowerCase();
            var sourceIds = Object.keys(fsSearchFields);

            for (var si = 0; si < sourceIds.length; si++) {
              if (results.length >= fsMaxResults) break;
              var sourceId = sourceIds[si];
              var fields = fsSearchFields[sourceId] || [];
              var features = _fsCache[sourceId] || [];

              for (var fi = 0; fi < features.length; fi++) {
                if (results.length >= fsMaxResults) break;
                var feat = features[fi];
                var props = feat.properties || {};

                for (var ki = 0; ki < fields.length; ki++) {
                  var fieldName = fields[ki];
                  var val = props[fieldName];
                  if (val == null) continue;
                  if (String(val).toLowerCase().includes(qLower)) {
                    var label = String(val);
                    var secondary = "";
                    for (var xi = 0; xi < fields.length; xi++) {
                      if (xi === ki) continue;
                      var sv = props[fields[xi]];
                      if (sv != null) { secondary = String(sv); break; }
                    }
                    results.push({
                      sourceId: sourceId,
                      feature: feat,
                      label: label,
                      secondary: secondary,
                      fieldLabel: fsFieldLabels[fieldName] || fieldName,
                    });
                    break;
                  }
                }
              }
            }
            return results;
          }

          function fsRenderResults(results) {
            fsDropdown.innerHTML = "";
            if (results.length === 0) {
              fsDropdown.innerHTML = '<div class="llmaps-feature-search-empty">No results</div>';
              fsDropdown.classList.add("visible");
              return;
            }
            results.forEach(function(r) {
              var div = document.createElement("div");
              div.className = "llmaps-feature-search-item";
              var text = r.label;
              if (r.secondary) text += " \u2014 " + r.secondary;
              div.textContent = text;
              var badge = document.createElement("span");
              badge.className = "llmaps-feature-search-item-source";
              badge.textContent = r.fieldLabel;
              div.appendChild(badge);
              div.addEventListener("click", function() {
                fsDropdown.classList.remove("visible");
                fsInput.value = "";
                fsFlyToFeature(r.feature);
                if (typeof window.llmapsSidebarOpen === "function") {
                  var layerCfg = (config.layers || []).find(function(l) { return l.source === r.sourceId; });
                  if (layerCfg) window.llmapsSidebarOpen(layerCfg.id, r.feature);
                }
              });
              fsDropdown.appendChild(div);
            });
            fsDropdown.classList.add("visible");
          }

          function fsFlyToFeature(feature) {
            var g = feature.geometry;
            if (!g) return;
            if (g.type === "Point" && g.coordinates) {
              maps.forEach(function(m) {
                m.flyTo({ center: g.coordinates, zoom: fsZoom, duration: 1500 });
              });
            } else {
              var bounds = new maplibregl.LngLatBounds();
              _fsForEachCoord(g, function(c) { bounds.extend(c); });
              if (!bounds.isEmpty()) {
                maps.forEach(function(m) {
                  m.fitBounds(bounds, { padding: 50, maxZoom: fsZoom });
                });
              }
            }
          }

          function _fsForEachCoord(geometry, fn) {
            if (geometry.type === "Point") { fn(geometry.coordinates); return; }
            if (geometry.type === "MultiPoint") { geometry.coordinates.forEach(fn); return; }
            if (geometry.type === "LineString") { geometry.coordinates.forEach(fn); return; }
            if (geometry.type === "Polygon") { geometry.coordinates[0].forEach(fn); return; }
            if (geometry.type === "MultiPolygon") {
              geometry.coordinates.forEach(function(poly) { poly[0].forEach(fn); });
              return;
            }
            if (geometry.type === "MultiLineString") {
              geometry.coordinates.forEach(function(line) { line.forEach(fn); });
            }
          }

          var fsTimer;
          fsInput.addEventListener("input", function() {
            clearTimeout(fsTimer);
            var q = fsInput.value.trim();
            if (q.length < fsMinChars) { fsDropdown.classList.remove("visible"); return; }
            fsTimer = setTimeout(function() { fsRenderResults(fsSearch(q)); }, fsDebounce);
          });
          fsInput.addEventListener("keydown", function(e) {
            if (e.key === "Enter") {
              e.preventDefault();
              var firstItem = fsDropdown.querySelector(".llmaps-feature-search-item");
              if (firstItem) firstItem.click();
            }
            if (e.key === "Escape") { fsDropdown.classList.remove("visible"); fsInput.blur(); }
          });
          document.addEventListener("click", function(e) {
            if (!fsWrap.contains(e.target)) fsDropdown.classList.remove("visible");
          });

          window.llmapsOnLayersReady(function() { fsBuildCache(); });
        }

        const searchConfig = components.find(c => c.type === "search");
        if (searchConfig && maps.length > 0) {
          const wrap = document.createElement("div");
          wrap.className = "llmaps-search-wrap " + (searchConfig.position || "top-left");
          const input = document.createElement("input");
          input.type = "text";
          input.placeholder = searchConfig.placeholder || "Search address...";
          input.id = "llmaps-address-search";
          wrap.appendChild(input);
          const suggestions = document.createElement("div");
          suggestions.className = "llmaps-search-suggestions";
          suggestions.id = "llmaps-search-suggestions";
          wrap.appendChild(suggestions);
          document.body.appendChild(wrap);

          const zoomOnResult = searchConfig.zoom_on_result ?? 15;
          const geocoderUrl = searchConfig.geocoder_url;
          const geocoderParams = searchConfig.geocoder_params || {};
          const autocomplete = searchConfig.autocomplete !== false;

          function parseCoords(data) {
            if (Array.isArray(data.center)) return data.center;
            if (data.lon != null && data.lat != null) return [data.lon, data.lat];
            if (data.lng != null && data.lat != null) return [data.lng, data.lat];
            const f = data.features && data.features[0];
            if (f && f.geometry && f.geometry.coordinates)
              return f.geometry.coordinates;
            const m = data.response && data.response.GeoObjectCollection && data.response.GeoObjectCollection.featureMember;
            if (m && m[0]) {
              const pos = m[0].GeoObject.Point.pos;
              return pos.split(" ").map(Number);
            }
            return null;
          }

          function buildGeocoderUrl(query, results) {
            if (!geocoderUrl) return null;
            const url = new URL(geocoderUrl);
            url.searchParams.set("geocode", query);
            if (results != null) url.searchParams.set("results", String(results));
            Object.entries(geocoderParams).forEach(([k, v]) => url.searchParams.set(k, v));
            return url.toString();
          }

          function flyToCoords(lon, lat) {
            maps.forEach(m => {
              if (m && m.flyTo) m.flyTo({ center: [lon, lat], zoom: zoomOnResult, duration: 2000 });
            });
          }

          let debounceTimer;
          function doSearch(address) {
            const url = buildGeocoderUrl(address, 1);
            if (!url) { console.warn("Search: geocoder_url not set"); return; }
            fetch(url).then(r => r.json()).then(data => {
              const coords = parseCoords(data);
              if (coords) flyToCoords(coords[0], coords[1]);
            }).catch(e => console.error("Geocoder error", e));
          }

          function showSuggestions(query) {
            const url = buildGeocoderUrl(query, 5);
            if (!url) return;
            fetch(url).then(r => r.json()).then(data => {
              const list = data.response && data.response.GeoObjectCollection && data.response.GeoObjectCollection.featureMember;
              suggestions.innerHTML = "";
              suggestions.classList.remove("visible");
              if (list && list.length) {
                list.slice(0, 5).forEach(item => {
                  const text = item.GeoObject && item.GeoObject.metaDataProperty && item.GeoObject.metaDataProperty.GeocoderMetaData
                    ? item.GeoObject.metaDataProperty.GeocoderMetaData.text
                    : (item.GeoObject && item.GeoObject.name) || "";
                  const div = document.createElement("div");
                  div.textContent = text;
                  div.onclick = () => { input.value = text; doSearch(text); suggestions.classList.remove("visible"); };
                  suggestions.appendChild(div);
                });
                suggestions.classList.add("visible");
              }
            }).catch(() => {});
          }

          input.addEventListener("keypress", function(e) {
            if (e.key === "Enter") { e.preventDefault(); doSearch(input.value.trim()); }
          });
          if (autocomplete) {
            input.addEventListener("input", function() {
              clearTimeout(debounceTimer);
              const q = input.value.trim();
              if (q.length < 3) { suggestions.classList.remove("visible"); return; }
              debounceTimer = setTimeout(() => showSuggestions(q), 300);
            });
            input.addEventListener("blur", () => setTimeout(() => suggestions.classList.remove("visible"), 200));
          }
        }
      }
