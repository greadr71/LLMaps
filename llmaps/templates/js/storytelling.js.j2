{# Storytelling: Scrollama-based scrollytelling with map reactions #}
{% if config.storytelling %}
      (function() {
        var storyConfig = {{ config.storytelling | tojson }};
        var scenes = storyConfig.scenes || [];
        if (!scenes.length) return;

        /* ── Track known layer ids from config for visibility toggling ── */
        var allLayerIds = ({{ config.layers | tojson }}).map(function(l) { return l.id; });
        /* Include outline layers (llmaps adds -outline suffix for thick strokes) */
        var allLayerIdsWithOutline = [];
        allLayerIds.forEach(function(id) {
          allLayerIdsWithOutline.push(id);
          allLayerIdsWithOutline.push(id + "-outline");
        });

        var currentSceneIndex = -1;
        var highlightedFeatures = []; /* [{source, id}] for clearing */
        var isJumping = false;
        var storyMap = null;

{% if config.storytelling.hasComparison %}
{% include "js/storytelling_comparison.js.j2" %}
{% endif %}

        /* ── Apply scene to map ── */
        function applyScene(map, scene, index) {
          if (currentSceneIndex === index) return;
          currentSceneIndex = index;

{% if config.storytelling.hasComparison %}
          /* Comparison scene? */
          if (scene.comparison) {
            /* Camera (applied to main map first; sync will propagate) */
            var flyOpts = { duration: scene.flyDuration || 2000 };
            if (scene.center) flyOpts.center = scene.center;
            if (scene.zoom != null) flyOpts.zoom = scene.zoom;
            flyOpts.bearing = scene.bearing || 0;
            flyOpts.pitch = scene.pitch || 0;
            if (scene.center || scene.zoom != null) {
              map.flyTo(flyOpts);
            }

            if (!storyConfig.keepMainLayersVisibleInComparison) {
              /* Hide all layers on main map too */
              allLayerIdsWithOutline.forEach(function(layerId) {
                if (!map.getLayer(layerId)) return;
                map.setLayoutProperty(layerId, "visibility", "none");
              });
            }
            clearHighlights(map);
            updateNavDots(index);
            updateMobileProgress(index);
            var steps = document.querySelectorAll(".story-step");
            steps.forEach(function(el, i) { el.classList.toggle("is-active", i === index); });

            ensureCompReady(function() {
              configureCompScene(scene);
              if (compCompare && typeof compCompare.setSlider === "function") {
                var sliderOffset = compContainer
                  ? Math.round(compContainer.offsetWidth * compSliderStartPct)
                  : 100;
                compCompare.setSlider(sliderOffset);
              }
              syncFromMain();
              showComparison();
              if (!sliderTooltipShown) {
                sliderTooltipShown = true;
                showSliderTooltip();
              }
            });

            try {
              window.dispatchEvent(new CustomEvent("llmaps:storySceneChanged", {
                detail: { index: index, sceneId: scene.id || null }
              }));
            } catch (e) {}
            return;
          }

          /* Non-comparison scene: hide comparison overlay */
          if (compVisible || (compContainer && compContainer.classList.contains("is-visible"))) {
            hideComparison();
          }
{% endif %}

          /* Camera */
          var flyOpts = { duration: scene.flyDuration || 2000 };
          if (scene.center) flyOpts.center = scene.center;
          if (scene.zoom != null) flyOpts.zoom = scene.zoom;
          flyOpts.bearing = scene.bearing || 0;
          flyOpts.pitch = scene.pitch || 0;
          if (scene.center || scene.zoom != null) {
            map.flyTo(flyOpts);
          }

          /* Layer visibility */
          if (scene.visibleLayers != null) {
            var visible = new Set(scene.visibleLayers);
            allLayerIdsWithOutline.forEach(function(layerId) {
              if (!map.getLayer(layerId)) return;
              /* Match base layer id (strip -outline suffix for lookup) */
              var baseId = layerId.endsWith("-outline") ? layerId.slice(0, -8) : layerId;
              var show = visible.has(baseId) ? "visible" : "none";
              map.setLayoutProperty(layerId, "visibility", show);
            });
          }

          /* Feature highlights */
          clearHighlights(map);
          var hl = scene.highlight || {};
          Object.keys(hl).forEach(function(sourceId) {
            var ids = hl[sourceId] || [];
            ids.forEach(function(featureId) {
              map.setFeatureState(
                { source: sourceId, id: featureId },
                { highlighted: true }
              );
              highlightedFeatures.push({ source: sourceId, id: featureId });
            });
          });

          /* Update nav dots + mobile progress */
          updateNavDots(index);
          updateMobileProgress(index);

          /* Update active step class */
          var steps = document.querySelectorAll(".story-step");
          steps.forEach(function(el, i) {
            el.classList.toggle("is-active", i === index);
          });

          try {
            window.dispatchEvent(new CustomEvent("llmaps:storySceneChanged", {
              detail: { index: index, sceneId: scene.id || null }
            }));
          } catch (e) {}
        }

        function clearHighlights(map) {
          highlightedFeatures.forEach(function(h) {
            try {
              map.setFeatureState(
                { source: h.source, id: h.id },
                { highlighted: false }
              );
            } catch(e) { /* source may not exist yet */ }
          });
          highlightedFeatures = [];
        }

        /* ── Navigation dots ── */
        function buildNavDots() {
          if (!storyConfig.progress) return;
          var nav = document.createElement("div");
          nav.className = "llmaps-story-nav nav-" +
            (storyConfig.position === "left" ? "right" : "left");

          scenes.forEach(function(scene, i) {
            var dot = document.createElement("div");
            dot.className = "nav-dot";
            dot.dataset.index = i;

            var tip = document.createElement("span");
            tip.className = "nav-tooltip";
            tip.textContent = scene.title;
            dot.appendChild(tip);

            dot.addEventListener("click", function() {
              var targetIndex = i;
              var target = document.querySelector('.story-step[data-index="' + targetIndex + '"]');
              if (!target || !storyMap) return;

              isJumping = true;
              applyScene(storyMap, scenes[targetIndex], targetIndex);
              target.scrollIntoView({ behavior: "instant", block: "start" });
              setTimeout(function() { isJumping = false; }, 50);
            });

            nav.appendChild(dot);
          });

          document.body.appendChild(nav);
        }

        function updateNavDots(activeIndex) {
          var dots = document.querySelectorAll(".llmaps-story-nav .nav-dot");
          dots.forEach(function(dot, i) {
            dot.classList.toggle("is-active", i === activeIndex);
          });
        }

        /* ── Mobile progress counter ── */
        function updateMobileProgress(index) {
          var progressEl = document.querySelector(".llmaps-story-progress-mobile");
          if (!progressEl) return;
          var textEl = progressEl.querySelector(".progress-text");
          var barEl = progressEl.querySelector(".progress-bar");
          var total = scenes.length;
          if (textEl) textEl.textContent = (index + 1) + " / " + total;
          if (barEl) barEl.style.width = ((index + 1) / total * 100).toFixed(1) + "%";
        }

        /* ── Scrollama setup ── */
        function initScrollama(map) {
          if (typeof scrollama === "undefined") {
            console.warn("LLMaps Storytelling: scrollama not loaded");
            return;
          }

          var scroller = scrollama();
          scroller
            .setup({
              step: ".story-step",
              offset: 0.5,
              container: ".llmaps-story-narrative"
            })
            .onStepEnter(function(response) {
              if (isJumping) return;
              applyScene(map, scenes[response.index], response.index);
            });

          window.addEventListener("resize", scroller.resize);

          /* Apply initial scene (reads ?step=N via llmapsDesiredInitialSlide) */
          var initialIdx = (typeof window.llmapsDesiredInitialSlide === "number")
            ? window.llmapsDesiredInitialSlide : 0;
          if (initialIdx < 0 || initialIdx >= scenes.length) initialIdx = 0;
          if (scenes.length > 0) {
            applyScene(map, scenes[initialIdx], initialIdx);
            if (initialIdx > 0) {
              isJumping = true;
              var nar = document.querySelector('.llmaps-story-narrative');
              var target = nar && nar.querySelector('.story-step[data-index="' + initialIdx + '"]');
              if (nar && target) {
                nar.scrollTop = target.getBoundingClientRect().top - nar.getBoundingClientRect().top;
              }
              setTimeout(function() { isJumping = false; }, 50);
            }
          }
        }

        function initMobileScrollFallback(map) {
          if (!storyConfig.mobileScrollFallback) return;
          var nar = document.querySelector(".llmaps-story-narrative");
          if (!nar) return;

          var lastFallbackIdx = -1;
          nar.addEventListener("scroll", function() {
            if (window.llmapsStorySwiper) return;
            if (isJumping) return;

            var stepsEls = nar.querySelectorAll(".story-step");
            if (!stepsEls.length) return;

            var rect = nar.getBoundingClientRect();
            var mid = rect.top + rect.height * 0.5;
            var best = 0;
            var bestDist = Infinity;

            stepsEls.forEach(function(step, i) {
              var sr = step.getBoundingClientRect();
              var dist = Math.abs(sr.top + sr.height * 0.5 - mid);
              if (dist < bestDist) {
                bestDist = dist;
                best = i;
              }
            });

            if (best !== lastFallbackIdx) {
              lastFallbackIdx = best;
              applyScene(map, scenes[best], best);
            }
          }, { passive: true });
        }

        /* ── Init on layers ready ── */
        buildNavDots();
        (function() {
          var narrative = document.querySelector(".llmaps-story-narrative");
          if (narrative && storyConfig.snapMode === "mandatory") {
            narrative.classList.add("snap-mandatory");
          }
        })();
        window.llmapsOnLayersReady(function(map) {
          storyMap = map;
          window.llmapsStoryMap = map;
          if (storyConfig.exposeSceneBridge) {
            window.llmapsApplySceneByIndex = function(index) {
              var idx = Number(index);
              if (!Number.isFinite(idx)) return;
              if (idx < 0 || idx >= scenes.length) return;
              applyScene(map, scenes[idx], idx);
            };
          }
          initScrollama(map);
          initMobileScrollFallback(map);
{% if config.storytelling.hasComparison %}
          if (storyConfig.prewarmComparison) {
            setTimeout(function() { ensureCompReady(function() {}); }, 0);
          }
{% endif %}
        });

        /* ── Touch swipe navigation (mobile) ── */
        (function() {
          var narrative = document.querySelector(".llmaps-story-narrative");
          if (!narrative) return;
          if (!("ontouchstart" in window)) return;
          if (narrative.dataset.noLibraryTouch) return;
          if (storyConfig.touchSwipe === false) return;

          var touchStartY = 0;
          var touchLocked = false;
          var SWIPE_THRESHOLD = 40;
          var LOCK_MS = 600;

          narrative.addEventListener("touchstart", function(e) {
            if (e.touches.length !== 1) return;
            touchStartY = e.touches[0].clientY;
          }, { passive: true });

          narrative.addEventListener("touchend", function(e) {
            if (touchLocked) return;
            var deltaY = touchStartY - (e.changedTouches[0] || {}).clientY;
            if (Math.abs(deltaY) < SWIPE_THRESHOLD) return;

            var dir = deltaY > 0 ? 1 : -1;
            var next = currentSceneIndex + dir;
            if (next < 0 || next >= scenes.length) return;

            touchLocked = true;
            var target = document.querySelector('.story-step[data-index="' + next + '"]');
            if (target && storyMap) {
              isJumping = true;
              applyScene(storyMap, scenes[next], next);
              target.scrollIntoView({ behavior: "smooth", block: "start" });
              setTimeout(function() { isJumping = false; }, 50);
            }
            setTimeout(function() { touchLocked = false; }, LOCK_MS);
          }, { passive: true });
        })();
      })();
{% endif %}
