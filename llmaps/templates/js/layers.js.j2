{# Layers: visibility optimization, loadLayers, addLayerFromConfig, createSingleMap #}
{{ visibility_optimization_js | safe }}

      function loadLayers(map, config, embeddedSources, layerIdsFilter) {
        const layers = config.layers || [];
        const sourceIds = new Set(layers.map(l => l.source));
        const embedded = config.embedded_sources || embeddedSources || {};
        return Promise.all(
          Array.from(sourceIds).map(id =>
            addSourceFromConfig(map, config, id, embedded)
          )
        ).then(() => {
          layers.forEach(l => addLayerFromConfig(map, l, layerIdsFilter));
        });
      }

      function addLayerFromConfig(map, layerConfig, layerIdsToAdd) {
        if (layerIdsToAdd && !layerIdsToAdd.includes(layerConfig.id)) return;
        if (map.getLayer(layerConfig.id)) return;
        const layer = {
          id: layerConfig.id,
          type: layerConfig.type || "circle",
          source: layerConfig.source,
          paint: layerConfig.paint || {},
          layout: layerConfig.layout || {}
        };
        if (layerConfig["source-layer"] != null)
          layer["source-layer"] = layerConfig["source-layer"];
        if (layerConfig.visible === false) {
          layer.layout.visibility = "none";
        }
        if (layerConfig.minzoom != null) layer.minzoom = layerConfig.minzoom;
        if (layerConfig.maxzoom != null) layer.maxzoom = layerConfig.maxzoom;
        map.addLayer(layer);
      }

      // Event queue for llmapsOnLayersReady callbacks
      window._llmapsReadyCallbacks = window._llmapsReadyCallbacks || [];
      window._llmapsLayersReady = false;
      window._llmapsReadyMap = null;
      window.llmapsOnLayersReady = function(fn) {
        if (typeof fn === 'function') {
          window._llmapsReadyCallbacks.push(fn);
          // If layers already loaded, call immediately
          if (window._llmapsLayersReady && window._llmapsReadyMap) {
            fn(window._llmapsReadyMap);
          }
        }
      };

      /**
       * Apply feature-state bindings declared in layer configs.
       * For each layer with a ``featureState`` dict, iterates over the
       * source GeoJSON features and calls ``map.setFeatureState``.
       *
       * String values in the dict are treated as GeoJSON property names;
       * all other values (bool, number) are used as constants.
       */
      function applyFeatureStates(map, config) {
        var layers = config.layers || [];
        var sources = config.sources || {};
        layers.forEach(function(lc) {
          if (!lc.featureState) return;
          var sourceId = lc.source;
          var srcConfig = sources[sourceId];
          var promoteId = srcConfig && srcConfig.promoteId;
          var geojson = window._llmapsSourceGeoJson && window._llmapsSourceGeoJson[sourceId];
          if (!geojson || !geojson.features) {
            console.warn("applyFeatureStates: no GeoJSON data for source '" + sourceId + "'");
            return;
          }
          var bindings = lc.featureState;
          var count = 0;
          geojson.features.forEach(function(f) {
            var id = promoteId ? f.properties[promoteId] : f.id;
            if (id == null) return;
            var state = {};
            for (var key in bindings) {
              var val = bindings[key];
              state[key] = (typeof val === "string") ? f.properties[val] : val;
            }
            map.setFeatureState({ source: sourceId, id: id }, state);
            count++;
          });
          console.log("Feature states set for " + count + " features in source '" + sourceId + "'");
        });
      }

      function parseMapHash(hashValue) {
        if (!hashValue) return null;
        const raw = hashValue.charAt(0) === "#" ? hashValue.slice(1) : hashValue;
        const parts = raw.split("/");
        if (parts.length !== 3) return null;

        const zoom = Number(parts[0]);
        const lat = Number(parts[1]);
        const lon = Number(parts[2]);
        const valid = [zoom, lat, lon].every(Number.isFinite)
          && lat >= -90 && lat <= 90
          && lon >= -180 && lon <= 180
          && zoom >= 0 && zoom <= 24;

        if (!valid) return null;
        return { center: [lon, lat], zoom: zoom };
      }

      function formatMapHash(map) {
        const center = map.getCenter();
        const zoom = map.getZoom();
        return zoom.toFixed(2) + "/" + center.lat.toFixed(5) + "/" + center.lng.toFixed(5);
      }

      function updateLocationHash(hashValue) {
        const nextHash = "#" + hashValue;
        if (window.location.hash === nextHash) return;
        const base = window.location.pathname + window.location.search;
        if (window.history && typeof window.history.replaceState === "function") {
          window.history.replaceState(null, "", base + nextHash);
        } else {
          window.location.hash = hashValue;
        }
      }

      function enableMapHashSync(map) {
        if (!map || map._llmapsHashSyncEnabled) return;
        map._llmapsHashSyncEnabled = true;

        const sync = function() {
          updateLocationHash(formatMapHash(map));
        };

        map.on("load", sync);
        map.on("moveend", sync);
      }

      function isHashPositionEnabled(config) {
        if (typeof config.hash_position === "boolean") return config.hash_position;
        const controls = (config.components || []).find(function(c) { return c.type === "controls"; });
        if (controls && typeof controls.hash === "boolean") return controls.hash;
        return false;
      }

      function createSingleMap(containerId, config, layerIdsFilter, embeddedSources, options) {
        const useHash = !!(options && options.hashSync);
        const hashState = useHash ? parseMapHash(window.location.hash) : null;
        const center = (hashState && hashState.center) || config.center || [0, 0];
        const zoom = (hashState && hashState.zoom) ?? (config.zoom ?? 10);
        const tiles = config.tiles || {};
        const styleUrl = (config && config.style_url) || null;

        const mapOptions = {
          container: containerId,
          center: center,
          zoom: zoom,
          attributionControl: false
        };

        // If an explicit external style is provided in the config
        // (e.g. Lightberry from WB Maps), use it directly.
        // Otherwise, build a basic raster style.
        if (styleUrl) {
          mapOptions.style = styleUrl;
        } else {
          mapOptions.style = buildBaseStyle(center, zoom, tiles);
        }

        const map = new maplibregl.Map(mapOptions);

        // Single attribution control: style/sources + custom LLMaps label.
        if (typeof maplibregl.AttributionControl === "function") {
          const customAttr = config.custom_attribution || '© LLMaps';
          map.addControl(new maplibregl.AttributionControl({
            customAttribution: customAttr
          }), "bottom-right");
        }
        if (useHash) enableMapHashSync(map);

        const layers = config.layers || [];
        const embedded = config.embedded_sources || embeddedSources || {};

        map._loadLayers = () => {
          if (map._layersLoading) {
            console.warn('Layers are already loading, skipping duplicate call');
            return Promise.resolve();
          }
          map._layersLoading = true;
          return loadLayers(map, config, embedded, layerIdsFilter).then(() => {
            applyFeatureStates(map, config);
            map._layersLoading = false;
            window._llmapsLayersReady = true;
            window._llmapsReadyMap = map;
            window._llmapsReadyCallbacks.forEach(fn => fn(map));
          }).catch(err => {
            map._layersLoading = false;
            throw err;
          });
        };

        map.on("load", function() {
          map._loadLayers().then(() => {
            map._layersLoaded = true;
          });
        });

        return map;
      }

      /**
       * Safely destroy a map instance and release its WebGL context.
       * Call before removing the map container from DOM when using lazy_init
       * or when evicting due to max_active_maps. Idempotent if map already removed.
       */
      function destroySingleMap(map) {
        if (!map) return;
        try {
          if (typeof map.remove === "function") map.remove();
        } catch (e) {
          if (typeof console !== "undefined" && console.warn) console.warn("LLMaps: destroySingleMap", e);
        }
        map._layersLoaded = false;
        map._layersLoading = false;
        if (window._llmapsReadyMap === map) {
          window._llmapsReadyMap = null;
          window._llmapsLayersReady = false;
        }
        if (window.llmaps_maps && Array.isArray(window.llmaps_maps)) {
          window.llmaps_maps = window.llmaps_maps.filter(function(m) { return m !== map; });
        }
        if (window.llmaps_map === map) window.llmaps_map = null;
      }
