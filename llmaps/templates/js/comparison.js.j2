{# Comparison: setupComparison (two maps + maplibre-gl-compare) #}
      function setupComparison(root, config) {
        const comp = config.comparison;
        const leftIds = comp.left_layers || [];
        const rightIds = comp.right_layers || [];
        root.id = "llmaps-comparison-container";
        root.innerHTML = [
          '<div id="llmaps-compare-before" class="llmaps-compare-map"></div>',
          '<div id="llmaps-compare-after" class="llmaps-compare-map"></div>'
        ].join("");

        const embedded = config.embedded_sources || {};
        const allConfigLayerIds = (config.layers || []).map(function(l) { return l.id; });
        function withOutlineLayers(ids) {
          var result = ids.slice();
          ids.forEach(function(id) {
            if (allConfigLayerIds.indexOf(id + "-outline") !== -1) result.push(id + "-outline");
          });
          return result;
        }
        const hashSyncEnabled = isHashPositionEnabled(config);
        const beforeMap = createSingleMap(
          "llmaps-compare-before",
          config,
          withOutlineLayers(leftIds),
          embedded,
          { hashSync: false }
        );
        const afterMap = createSingleMap(
          "llmaps-compare-after",
          config,
          withOutlineLayers(rightIds),
          embedded,
          { hashSync: false }
        );

        function enableComparisonHashSync(mapLeft, mapRight) {
          if (!hashSyncEnabled) return;

          var isSyncing = false;
          function syncHashFrom(source) {
            if (isSyncing) return;
            isSyncing = true;
            updateLocationHash(formatMapHash(source));
            isSyncing = false;
          }

          var initialHash = parseMapHash(window.location.hash);
          if (initialHash) {
            mapLeft.jumpTo(initialHash);
            mapRight.jumpTo(initialHash);
          } else if (mapLeft && typeof mapLeft.getCenter === "function") {
            updateLocationHash(formatMapHash(mapLeft));
          }

          mapLeft.on("moveend", function() { syncHashFrom(mapLeft); });
          mapRight.on("moveend", function() { syncHashFrom(mapRight); });

          window.addEventListener("hashchange", function() {
            var hashState = parseMapHash(window.location.hash);
            if (!hashState || isSyncing) return;
            isSyncing = true;
            mapLeft.jumpTo(hashState);
            mapRight.jumpTo(hashState);
            isSyncing = false;
          });
        }

        if (typeof maplibregl.Compare !== "function") {
          console.warn("maplibre-gl-compare not loaded; comparison uses basic sync only.");
          beforeMap.on("moveend", function() {
            afterMap.setCenter(beforeMap.getCenter());
            afterMap.setZoom(beforeMap.getZoom());
          });
          afterMap.on("moveend", function() {
            beforeMap.setCenter(afterMap.getCenter());
            beforeMap.setZoom(afterMap.getZoom());
          });
          enableComparisonHashSync(beforeMap, afterMap);
          return { mapLeft: beforeMap, mapRight: afterMap };
        }

        var compare = new maplibregl.Compare(beforeMap, afterMap, "#llmaps-comparison-container", {
          mousemove: false,
          orientation: "vertical"
        });

        enableComparisonHashSync(beforeMap, afterMap);
        return { mapLeft: beforeMap, mapRight: afterMap };
      }
