      async function getGeoJsonSource(config, sourceId, embeddedSources) {
        const src = config.sources && config.sources[sourceId];
        if (!src) return null;
        if (embeddedSources && embeddedSources[sourceId] !== undefined) {
          let data = embeddedSources[sourceId];
          if (typeof data === "string") {
            if (typeof decompressData === "function") data = await decompressData(data);
            else return null;
          }
          if (data && data.features && typeof explodeMultiPoint === "function" &&
              data.features.some(f => f.geometry && f.geometry.type === "MultiPoint"))
            data = await new Promise(r => explodeMultiPoint(data, r));
          return data ? { type: "geojson", data } : null;
        }
        if (src.type === "api") {
          const url = new URL(src.url);
          if (src.params)
            Object.entries(src.params).forEach(([k, v]) => url.searchParams.set(k, v));
          const res = await fetch(url.toString(), { headers: src.headers || {} });
          let data = await res.json();
          if (data && data.features && typeof explodeMultiPoint === "function" &&
              data.features.some(f => f.geometry && f.geometry.type === "MultiPoint"))
            data = await new Promise(r => explodeMultiPoint(data, r));
          return { type: "geojson", data };
        }
        if (src.type === "file" && src.path) {
          try {
            const res = await fetch(src.path);
            let data = await res.json();
            if (data && data.features && typeof explodeMultiPoint === "function" &&
                data.features.some(f => f.geometry && f.geometry.type === "MultiPoint"))
              data = await new Promise(r => explodeMultiPoint(data, r));
            return { type: "geojson", data };
          } catch (e) {
            console.warn("Could not load file source " + sourceId + ": " + e.message);
            return null;
          }
        }
        return null;
      }

      // Feature state utilities (require promoteId on the source)
      window.llmapsClearFeatureStates = function(sourceId) {
        const map = window.llmaps_map;
        if (!map || !map.getSource(sourceId)) return;
        map.removeFeatureState({ source: sourceId });
      };
      window.llmapsSetFeatureState = function(sourceId, featureId, state) {
        const map = window.llmaps_map;
        if (!map || !map.getSource(sourceId)) return;
        map.setFeatureState({ source: sourceId, id: featureId }, state);
      };

      /**
       * Public utility: retrieve GeoJSON data for a source.
       * Works with embedded (+ compressed) and remote sources.
       * Returns a Promise resolving to a GeoJSON object or null.
       *
       * Usage: const data = await window.llmapsGetSourceData("my-source");
       */
      window.llmapsGetSourceData = function(sourceId) {
        const config = readConfig();
        const embedded = config.embedded_sources || {};
        return getGeoJsonSource(config, sourceId, embedded).then(function(geo) {
          return geo && geo.data ? geo.data : null;
        });
      };

      // Store parsed GeoJSON data per source for feature-state binding
      window._llmapsSourceGeoJson = window._llmapsSourceGeoJson || {};

      function addSourceFromConfig(map, config, sourceId, embeddedSources) {
        const src = config.sources && config.sources[sourceId];
        if (!src || map.getSource(sourceId)) return Promise.resolve();
        if (src.type === "vector") {
          try {
            const vectorOpts = { type: "vector", tiles: src.tiles || [src.tiles_url] };
            if (src.promoteId) vectorOpts.promoteId = src.promoteId;
            map.addSource(sourceId, vectorOpts);
          } catch (e) {
            if (e.message && e.message.includes("already exists")) {
              console.warn(`Source ${sourceId} already exists, skipping`);
              return Promise.resolve();
            }
            throw e;
          }
          return Promise.resolve();
        }
        return getGeoJsonSource(config, sourceId, embeddedSources).then(geo => {
          if (geo) {
            if (src.promoteId) geo.promoteId = src.promoteId;
            // Keep a reference to parsed GeoJSON for feature-state binding
            if (geo.data) window._llmapsSourceGeoJson[sourceId] = geo.data;
            try {
              map.addSource(sourceId, geo);
            } catch (e) {
              if (e.message && e.message.includes("already exists")) {
                console.warn(`Source ${sourceId} already exists, skipping`);
                return;
              }
              throw e;
            }
          }
        });
      }
